# Server-side secrets: set these in the hosting platform's secret store, NOT in .env
# and NEVER with a VITE_ / NEXT_PUBLIC_ prefix (anything with those prefixes ships to
# the browser and is public).
#
# OPENAI_API_KEY=
#
# Publishable values the platform may commit to .env on purpose (safe to be public):
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=
